					<token name="RunContext">1</token>
					<string name="ScriptGuid">{C7B57956-61DE-482C-A113-7F2037532A17}</string>
					<BinaryString name="AttributesSerialize">AQAAAAoAAABCcmlnaHRuZXNzBhjXyIPkhPo/</BinaryString>
					<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
					<bool name="DefinesCapabilities">true</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">Script</string>
					<int64 name="SourceAssetId">-1</int64>
