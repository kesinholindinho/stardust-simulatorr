			<Item class="BloomEffect" referent="RBXD26F8377E1B54D8DB013DFB1AB13D83C">
				<Properties>
					<float name="Intensity">1</float>
					<float name="Size">65</float>
					<float name="Threshold">4</float>
					<bool name="Enabled">true</bool>
