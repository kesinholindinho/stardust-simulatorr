				</Properties>
			</Item>
			<Item class="ColorCorrectionEffect" referent="RBX278340B1285545458D79B87E3D5A1F7F">
				<Properties>
					<float name="Brightness">0.100000001</float>
					<float name="Contrast">0.300000012</float>
					<float name="Saturation">0</float>
					<Color3 name="TintColor">
						<R>1</R>
						<G>1</G>
						<B>1</B>
					</Color3>
					<bool name="Enabled">true</bool>
					<BinaryString name="AttributesSerialize"></BinaryString>
