					<UniqueId name="UniqueId">6e2a3edad1d083e90a02619800000c43</UniqueId>
				</Properties>
			</Item>
			<Item class="ColorCorrectionEffect" referent="RBXB76EB8639CBF48F58759C75038193C88">
				<Properties>
					<float name="Brightness">0.0500000007</float>
					<float name="Contrast">0.100000001</float>
					<float name="Saturation">0</float>
					<Color3 name="TintColor">
						<R>1</R>
						<G>1</G>
						<B>1</B>
					</Color3>
